# Copiar a .env (no se versiona) y completar con valores reales.
# En EC2: /opt/sicher/tesis_v22/.env  (lo lee sicher-api.service)

# ===== Envio de correo (Resend) =====
# API key de Resend. Crear en https://resend.com/api-keys
RESEND_API_KEY=re_tu_api_key_aqui
# Remitente. Debe ser una direccion del dominio verificado en Resend.
RESEND_FROM=Sicher <noreply@sircher.online>

# Habilitar/deshabilitar el envio de correos (alertas y reset de contrasena).
EMAIL_ALERTS_ENABLED=true

# ===== SMTP (respaldo, opcional) =====
# Solo se usa si RESEND_API_KEY no esta configurada.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS=true
